{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,
        "types": [
                    "vite/client"
        ],
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "strict": true,
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": false
    },
    "include": [
        "index.js",
        "components/**/*.vue",
        "composables/**/*.js",
        "composables/**/*.ts",
        "utils/**/*.js",
        "utils/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        ".test-output",
        "tests",
        "examples"
    ]
}
